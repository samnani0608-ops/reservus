# Variables públicas usadas por Next.js y los scripts autenticados.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para scripts locales de mantenimiento. Nunca usar en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
SEED_USER_PASSWORD=

# Usuario admin para demostrar 10 solicitudes concurrentes sin límite semanal.
CONCURRENCY_TEST_EMAIL=
CONCURRENCY_TEST_PASSWORD=
CONCURRENCY_TEST_ROOM_ID=
CONCURRENCY_START_AT=
CONCURRENCY_END_AT=

# Member de prueba limpio y datos pertenecientes a otro usuario.
SECURITY_TEST_EMAIL=
SECURITY_TEST_PASSWORD=
SECURITY_TEST_ROOM_ID=
SECURITY_OTHER_USER_ID=
SECURITY_OTHER_RESERVATION_ID=
